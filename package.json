{
  "name": "@castalia/filesystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs packages/browser/tests/*.test.mjs",
    "verify:extraction": "node scripts/verify-extraction.mjs",
    "build:package": "node scripts/build-package.mjs",
    "test:browser-retained": "vitest run --config packages/browser/vitest.config.mjs",
    "typecheck:browser": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM packages/browser/src/index.d.mts packages/browser/src/worker.d.mts packages/browser/src/shipping.d.mts"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@11.16.0",
  "exports": {
    "./registration": {
      "types": "./packages/browser/src/registration.d.mts",
      "default": "./packages/browser/src/registration.mjs"
    },
    "./browser": {
      "types": "./packages/browser/src/index.d.mts",
      "default": "./packages/browser/src/index.mjs"
    },
    "./worker": {
      "types": "./packages/browser/src/worker.d.mts",
      "default": "./packages/browser/src/worker.mjs"
    },
    "./registration-store": {
      "types": "./packages/browser/src/registration-store.d.mts",
      "default": "./packages/browser/src/registration-store.mjs"
    },
    "./database": {
      "types": "./packages/browser/src/database.d.mts",
      "default": "./packages/browser/src/database.mjs"
    },
    "./shipping": {
      "types": "./packages/browser/src/shipping.d.mts",
      "import": "./packages/browser/src/shipping.mjs"
    },
    "./shipping-worker": {
      "types": "./packages/browser/src/shipping-worker.d.mts",
      "import": "./packages/browser/src/shipping-worker.mjs"
    }
  },
  "dependencies": {
    "@zip.js/zip.js": "2.18.2"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "vitest": "4.1.11",
    "typescript": "5.9.3"
  },
  "files": [
    "packages/browser/src",
    "docs",
    "provenance",
    "licenses",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
